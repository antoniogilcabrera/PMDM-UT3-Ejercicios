<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 2: tablero de 2 filas y 3 columnas. Es un LinearLayout vertical con dos filas,
     y cada fila es otro LinearLayout horizontal con 3 celdas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Cabecera"
        android:text="PROGRAMACIÓN MULTIMEDIA\nPantalla 2 · Tablero rojo y blanco" />

    <!-- Fila de arriba: blanco | rojo | blanco -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_blanco" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_rojo" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_blanco" />
    </LinearLayout>

    <!-- Fila de abajo: rojo | blanco | rojo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_rojo" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_blanco" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_rojo" />
    </LinearLayout>
</LinearLayout>
