<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 1: verde estrecho | blanco ancho | verde estrecho -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Cabecera"
        android:text="PROGRAMACIÓN MULTIMEDIA\nPantalla 1 · ¡Bienvenido a la pantalla verde!" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Con los pesos 1 : 4 : 1 consigo que la franja del centro sea 4 veces más ancha que las verdes -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_verde" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:background="@color/ej3_blanco" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_verde" />
    </LinearLayout>
</LinearLayout>
