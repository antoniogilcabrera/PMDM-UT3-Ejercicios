<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 3: la mitad de arriba la divido en 3 columnas (blanco | rojo | blanco)
     y la de abajo en 3 franjas horizontales (azul / blanco / azul) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Cabecera"
        android:text="PROGRAMACIÓN MULTIMEDIA\nPantalla 3 · Bandera mixta" />

    <!-- Arriba uso un LinearLayout horizontal para las columnas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_blanco" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_rojo" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ej3_blanco" />
    </LinearLayout>

    <!-- Abajo uso uno vertical para las franjas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ej3_azul" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ej3_blanco" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ej3_azul" />
    </LinearLayout>
</LinearLayout>
