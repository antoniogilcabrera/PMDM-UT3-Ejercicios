<?xml version="1.0" encoding="utf-8"?>
<!--
  Calculadora con TableLayout: cada TableRow es una fila de botones y con stretchColumns="*"
  consigo que todas las columnas midan lo mismo.
  La pantalla y el botón C los he puesto sueltos dentro del TableLayout, sin TableRow, para que
  ocupen la fila entera. Con layout_span dentro de un TableRow no se me llegaban a ver.
-->
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_fondo"
    android:gravity="bottom"
    android:padding="12dp"
    android:stretchColumns="*"
    tools:context=".Ej5CalculadoraActivity">

    <!-- Fila 0: pantalla -->
    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:padding="16dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="48sp" />

    <!-- Fila 1: C (ocupa toda la fila) -->
    <Button
        android:id="@+id/btnBorrar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="C"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:backgroundTint="@color/calc_borrar" />

    <!-- Fila 2: 7 8 9 / -->
    <TableRow>
        <Button android:id="@+id/btn7" style="@style/BotonCalc" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/BotonCalc" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/BotonCalc" android:text="9" />
        <Button android:id="@+id/btnDividir" style="@style/BotonCalc.Operacion" android:text="/" />
    </TableRow>

    <!-- Fila 3: 4 5 6 * -->
    <TableRow>
        <Button android:id="@+id/btn4" style="@style/BotonCalc" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/BotonCalc" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/BotonCalc" android:text="6" />
        <Button android:id="@+id/btnMultiplicar" style="@style/BotonCalc.Operacion" android:text="*" />
    </TableRow>

    <!-- Fila 4: 1 2 3 - -->
    <TableRow>
        <Button android:id="@+id/btn1" style="@style/BotonCalc" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/BotonCalc" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/BotonCalc" android:text="3" />
        <Button android:id="@+id/btnRestar" style="@style/BotonCalc.Operacion" android:text="-" />
    </TableRow>

    <!-- Fila 5: 0 . = + -->
    <TableRow>
        <Button android:id="@+id/btn0" style="@style/BotonCalc" android:text="0" />
        <Button android:id="@+id/btnPunto" style="@style/BotonCalc" android:text="." />
        <Button android:id="@+id/btnIgual" style="@style/BotonCalc.Operacion" android:text="=" />
        <Button android:id="@+id/btnSumar" style="@style/BotonCalc.Operacion" android:text="+" />
    </TableRow>
</TableLayout>
