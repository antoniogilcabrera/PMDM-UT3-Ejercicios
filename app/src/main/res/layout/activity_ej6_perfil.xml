<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil con ConstraintLayout. Cada elemento lo ato a los bordes o a otro elemento:
   - El banner va arriba del todo, de lado a lado.
   - La foto la he dejado centrada y "a caballo" sobre el borde de abajo del banner, atando
     su parte de arriba y su parte de abajo al final del banner.
   - Debajo de la foto van el nombre, el rol y la descripción, uno detrás de otro.
   - El botón de contactar lo pego a la parte de abajo de la pantalla.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ej6PerfilActivity">

    <View
        android:id="@+id/banner"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@color/perfil_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgPerfil"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/fondo_avatar"
        android:contentDescription="Imagen de perfil"
        android:padding="16dp"
        android:src="@drawable/avatar_perfil"
        app:layout_constraintBottom_toBottomOf="@id/banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/banner" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Antonio Gil Cabrera"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPerfil" />

    <TextView
        android:id="@+id/tvRol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Estudiante de 2º DAM · Entrenador Pokémon"
        android:textColor="@color/perfil_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNombre" />

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Desarrollador en formación. Me gusta programar en Kotlin y Java, crear apps Android y coleccionar cartas. Actualmente trabajando en el proyecto Ohmazing."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRol" />

    <Button
        android:id="@+id/btnContactar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Contactar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
