<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo común para los botones del menú principal -->
    <style name="BotonMenu" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Cabecera "PROGRAMACIÓN MULTIMEDIA" de las pantallas del ejercicio 3 -->
    <style name="Cabecera">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/cabecera</item>
        <item name="android:textColor">@color/cabecera_texto</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botones de la calculadora (ejercicio 5) -->
    <style name="BotonCalc">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/calc_numero</item>
    </style>

    <style name="BotonCalc.Operacion">
        <item name="backgroundTint">@color/calc_operacion</item>
    </style>
</resources>
